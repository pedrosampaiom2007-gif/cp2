# ---------------------------------------------------------------------------
# CKP01 — Chatbot Profissional · variaveis de ambiente
# Copie este arquivo para .env e preencha com a sua chave:
#     cp .env.example .env
# O .env contem segredos e NUNCA deve ir para o .zip nem para o Git.
# ---------------------------------------------------------------------------

# Chave da Ollama Cloud (https://ollama.com -> Settings -> Keys)
OLLAMA_API_KEY=coloque_sua_chave_aqui

# Modelo obrigatorio do checkpoint (nao usar modelos deprecated)
OLLAMA_MODEL=gemma4:cloud

# Endpoint da Ollama Cloud
OLLAMA_BASE_URL=https://ollama.com

# Temperatura do modelo (0.0 = deterministico, 1.0 = criativo)
OLLAMA_TEMPERATURE=0.3

# Estrategia de memoria: buffer | summary | token_buffer
MEMORIA_ESTRATEGIA=token_buffer

# Teto de tokens da ConversationTokenBufferMemory (faixa exigida: 800-1500)
MEMORIA_MAX_TOKENS=1200

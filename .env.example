# ---------------------------------------------------------------------------
# CKP01 + CKP02 — Halter + DocMind RAG · variaveis de ambiente
# Copie este arquivo para .env e preencha com a sua chave:
#     cp .env.example .env
# O .env contem segredos e NUNCA deve ir para o .zip nem para o Git.
# ---------------------------------------------------------------------------

# Chave da Ollama Cloud (https://ollama.com -> Settings -> Keys)
OLLAMA_API_KEY=coloque_sua_chave_aqui

# Modelo obrigatorio do checkpoint (nao usar modelos deprecated)
OLLAMA_MODEL=gemma4:cloud

# Endpoint da Ollama Cloud
OLLAMA_BASE_URL=https://ollama.com

# Temperatura do modelo (0.0 = deterministico, 1.0 = criativo)
OLLAMA_TEMPERATURE=0.3

# Estrategia de memoria: buffer | summary | token_buffer
MEMORIA_ESTRATEGIA=token_buffer

# Teto de tokens da ConversationTokenBufferMemory (faixa exigida: 800-1500)
MEMORIA_MAX_TOKENS=1200

# ---------------------------------------------------------------------------
# DocMind RAG (CKP02)
# ---------------------------------------------------------------------------

# Modelo de embedding servido pela Ollama
OLLAMA_EMBED_MODEL=nomic-embed-text

# Endpoint dos embeddings. Vazio = mesmo endpoint do chat (Ollama Cloud).
# Para usar o Ollama instalado no computador: ollama pull nomic-embed-text
# e preencha com http://localhost:11434
OLLAMA_EMBED_BASE_URL=

# Temperatura do modelo na geracao com RAG
RAG_TEMPERATURE=0

# Tamanho de chunk usado pela interface (vencedor da comparacao RAGAS)
RAG_CHUNK_SIZE=512

# Chunks entregues ao LLM e candidatos buscados antes do reranking
RAG_TOP_K=4
RAG_CANDIDATOS=12

# Reordena os candidatos com cross-encoder antes de gerar a resposta
RAG_RERANKING=true

# Prefixo do nome das colecoes no ChromaDB
RAG_COLECAO=treino_academia
